# ═══════════════════════════════════════════════════════════
# Variáveis de Ambiente — AutoMarket (Arquitetura Headless & Integrações)
# Em produção, gere segredos aleatórios com >= 32 bytes (ex: openssl rand -hex 32)
# ═══════════════════════════════════════════════════════════

# Banco de Dados (SQLite dev / PostgreSQL prod)
DATABASE_URL="file:./dev.db"

# Segurança de Sessão Administrativa (OBRIGATÓRIO em produção: mínimo 32 caracteres)
JWT_SECRET=""
JWT_EXPIRES_IN="8h"

# ─── 1. Strapi Headless CMS (Gestão Administrativa & Catálogo) ───
NEXT_PUBLIC_STRAPI_URL="http://localhost:1337"
STRAPI_URL="http://localhost:1337"
STRAPI_API_TOKEN=""
STRAPI_WEBHOOK_SECRET=""

# ─── 2. Camada de Integração Externa (ERP / DMS Sync Anti-Duplo Cadastro) ───
ERP_WEBHOOK_SECRET=""

# ─── 3. Stripe Gateway (Obrigatório em produção para pagamentos reais) ───
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ─── 4. Estrutura para IA de Atendimento ao Cliente ───
AI_PROVIDER_API_KEY=""
AI_PROVIDER_MODEL="gpt-4o-mini"
AI_AGENT_WEBHOOK_URL=""

# ─── 5. Automação de Posts para Redes Sociais (Gatilhos Strapi) ───
SOCIAL_AUTOMATION_WEBHOOK_URL=""
NEXT_PUBLIC_SITE_URL="https://caiobpq.github.io/marketplace"

# Rate Limiting & Proxy Confiável
RATE_LIMIT_WINDOW_MS="60000"
RATE_LIMIT_MAX_REQUESTS="100"
TRUST_PROXY="false"
