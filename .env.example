# ═══════════════════════════════════════════════════════════
# Variáveis de Ambiente — AutoMarket (Arquitetura Headless & Integrações)
# ═══════════════════════════════════════════════════════════

# Banco de Dados Local / Fallback (SQLite / Prisma)
DATABASE_URL="file:./dev.db"

# Segurança de Sessão Administrativa
JWT_SECRET="automarket-strapi-bridge-secret-key-2026"

# ─── 1. Strapi Headless CMS (Gestão Administrativa & Catálogo) ───
NEXT_PUBLIC_STRAPI_URL="http://localhost:1337"
STRAPI_URL="http://localhost:1337"
STRAPI_API_TOKEN=""
STRAPI_WEBHOOK_SECRET="strapi-webhook-secret-2026"

# ─── 2. Camada de Integração Externa (ERP / DMS Sync Anti-Duplo Cadastro) ───
ERP_WEBHOOK_SECRET="erp-sync-secret-2026"

# ─── 3. Estrutura para IA de Atendimento ao Cliente ───
# Provedor opcional (OpenAI / Gemini / n8n Webhook). Sem chave, utiliza o Motor Semântico do Estoque Local.
AI_PROVIDER_API_KEY=""
AI_PROVIDER_MODEL="gpt-4o-mini"
AI_AGENT_WEBHOOK_URL=""

# ─── 4. Automação de Posts para Redes Sociais (Gatilhos Strapi) ───
# URL do fluxo externo (n8n, Make, Zapier ou Meta Graph API) que publica os posts gerados
SOCIAL_AUTOMATION_WEBHOOK_URL=""
NEXT_PUBLIC_SITE_URL="https://caiobpq.github.io/marketplace"
